# Provide via environment/secret manager. No auto-load or shipped credentials.
WH_WEB_ORIGIN=https://whitehat.example.com
WH_WEB_HOST=127.0.0.1
WH_WEB_PORT=3030
WH_API_BASE=http://127.0.0.1:8081
WH_OIDC_ISSUER=https://id.example.com/
WH_OIDC_CLIENT_ID=whitehat-web
WH_OIDC_CLIENT_SECRET=
# NEVER use insecure HTTP outside local 127.0.0.1 fixture development.
WH_DEV_INSECURE_HTTP=0

# Dedicated session database. Apply db/session-store.sql as the schema owner.
WH_WEB_SESSION_DATABASE_URL=
# Base64 AES-256 keys, newest first; set with the deployment secret manager.
WH_WEB_SESSION_KEYS=
