# Deployment configuration template. Values below are examples, not credentials.
WH_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/whitehat
WH_DATABASE_USER=whitehat_app
WH_DATABASE_PASSWORD=
WH_DATABASE_POOL_SIZE=8
WH_DATABASE_CONNECTION_TIMEOUT_MS=3000
WH_DATABASE_STATEMENT_TIMEOUT_MS=10000
WH_DATABASE_LOCK_TIMEOUT_MS=2000
WH_AUTH_ISSUER=https://identity.example.test/
WH_AUTH_JWKS_URL=https://identity.example.test/.well-known/jwks.json
WH_AUTH_AUDIENCE=whitehat-api
WH_AI_API_KEY=
WH_AI_MODEL=
WH_DAILY_RUN_LIMIT=20
WH_HOST=127.0.0.1
WH_PORT=8081
